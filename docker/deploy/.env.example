# Copy to docker/deploy/.env and fill in values before deploying.
# Never commit .env to git.

# Docker image tag to deploy (e.g. 1.0.0, latest, main)
IMAGE_TAG=latest

# OpenProject — hostname as seen by end users (include port if non-standard)
OPENPROJECT_HOST__NAME=openproject.yourdomain.com
OPENPROJECT_SECRET__KEY__BASE=changeme_run_openssl_rand_hex_64

# Set to false when running without TLS termination (e.g. behind a reverse proxy)
OPENPROJECT_HTTPS=true

# Database
DB_USER=openproject
DB_PASSWORD=changeme_strong_password
DB_NAME=openproject

# External port on the host machine (Puma always listens on 8080 inside the container)
HOST_PORT=8080
